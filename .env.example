# ---------------------------------------------------------------------------
# Variables de ejemplo. NUNCA subir valores reales al repositorio.
#
# En Cloudflare Workers las variables NO se leen de .env: se declaran en
# wrangler.jsonc (`vars`, valores no sensibles) o se cargan como secretos con:
#
#   npx wrangler secret put NOMBRE
#
# Este archivo documenta que valores existen y para que sirven.
# Para desarrollo local, copia .dev.vars.example a .dev.vars
# ---------------------------------------------------------------------------

# Entorno de ejecucion: development | production
ENVIRONMENT=development

# Origen publico de la aplicacion. Se usa para validar el header Origin (anti-CSRF)
# y para construir enlaces compartibles.
APP_ORIGIN=http://localhost:5173

# Duracion de la sesion en horas.
SESSION_TTL_HOURS=12

# Iteraciones de PBKDF2-HMAC-SHA256 para el hash de contrasenas.
# Mas iteraciones = mas seguro pero mas CPU por login.
# Ver README ("Coste y limites del plan gratuito") antes de subirlo en el plan Free.
AUTH_PBKDF2_ITERATIONS=100000

# Tamano maximo de cartelera subida a R2, en bytes (5 MiB por defecto).
MAX_UPLOAD_BYTES=5242880

# Credenciales del primer administrador (solo se usan por scripts/create-admin.mjs,
# nunca se leen en runtime).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave
